// hosts.kdl  (KDL 2.0)
// Nodes: vars, defaults, host, group.

vars {                                  // workspace-wide vars: the "all" level
    fruit "banana"
    timezone "America/Sao_Paulo"
}

defaults ssh_user="cadu" port=22 escalate="sudo"   // workspace-wide parameters

host "laptop" connection="local"

group "web" ssh_user="deploy" {         // group-level parameter
    vars {
        nginx_workers 4
        allowed_ports 22 80 443         // list: positional arguments -> Vec<u16>
        tls #true
    }
    host "web1" addr="10.0.1.11"
    host "web2" addr="10.0.1.12" {
        vars { nginx_workers 8 }        // host-level override
    }
}

group "db" {
    vars { pg_version 16 }
    host "db1" addr="10.0.2.11" ssh_user="pgadmin" port=2222 {
        vars { role "primary" }
    }
    host "db2" addr="10.0.2.12" {
        vars {
            role "replica"
            replica_of "db1"
        }
    }
}

group "production" {                    // group of groups
    members "web" "db"
    vars { env "production" }
}

group "monitored" {
    members "web1" "db1"                // cherry-pick hosts by name
    vars { alerts #true }
}

/-host "web3" addr="10.0.1.13" {        // slash-dash: disabled, children included
    vars { nginx_workers 2 }
}

// The machines the unattended build runs against: this VM and the ARM VM.
// `playbooks/cadu/mc.rs` targets this group and needs `package`.
group "lab" {
    vars { package "mc" }
    host "local" connection="local"
    host "arm" addr="cadu-cogram-vm-arm" ssh_user="cadu"
}

// The machines `dev/vagrant/Vagrantfile` brings up, for
// `playbooks/vagrant.rs`. `vagrant up` writes the real block, with this
// checkout's key path and the address the provider handed out, to
// `dev/vagrant/hosts.vagrant.kdl`; paste it in here, replacing this comment.
// It is not committed because both of those name one developer's disk.
//
// group "vagrant" escalate="sudo" {
//     host "vagrant-x86" addr="192.168.121.116" ssh_user="vagrant" port=22 {
//         ssh_args "-i" "/path/to/rustible/dev/vagrant/.vagrant/machines/x86/libvirt/private_key" "-o" "IdentitiesOnly=yes" "-o" "StrictHostKeyChecking=no" "-o" "UserKnownHostsFile=/dev/null"
//     }
// }
