// hosts.kdl  (KDL 2.0)
// Nodes: vars, defaults, host, group.

vars {                                  // workspace-wide vars: the "all" level
    fruit "banana"
    timezone "America/Sao_Paulo"
}

defaults ssh_user="cadu" port=22 escalate="sudo"   // workspace-wide parameters

host "laptop" connection="local"

group "web" ssh_user="deploy" {         // group-level parameter
    vars {
        nginx_workers 4
        allowed_ports 22 80 443         // list: positional arguments -> Vec<u16>
        tls #true
    }
    host "web1" addr="10.0.1.11"
    host "web2" addr="10.0.1.12" {
        // host-level override
        vars { nginx_workers 8 }
    }
}

group "db" {
    vars { pg_version 16 }
    host "db1" addr="10.0.2.11" ssh_user="pgadmin" port=2222 {
        vars { role "primary" }
    }
    host "db2" addr="10.0.2.12" {
        vars {
            role "replica"
            replica_of "db1"
        }
    }
}

group "production" {                    // group of groups
    members "web" "db"
    vars { env "production" }
}

group "monitored" {
    members "web1" "db1"                // cherry-pick hosts by name
    vars { alerts #true }
}

/-host "web3" addr="10.0.1.13" {        // slash-dash: disabled, children included
    vars { nginx_workers 2 }
}

// Every host above is fictional, and that is deliberate: this file is read by
// everyone who clones the repository, so it names nobody's machines. The one
// host that does anything is `laptop`, which is this machine by way of
// `connection="local"`.
//
// The playbooks that need a real target -- `vagrant.rs` and everything under
// `playbooks/demo/` -- target a group named "vagrant", which is not here.
// `dev/vagrant/Vagrantfile` writes it to `dev/vagrant/hosts.vagrant.kdl` on
// `vagrant up`, naming the key path and address of the guests on the machine
// it ran on. That file is a complete inventory and is used instead of this
// one:
//
//     make vm-up && make vm-test
//
// which is `rustible --inventory dev/vagrant/hosts.vagrant.kdl ...`. To run
// the demo playbooks against hardware of your own, write an inventory like it
// and pass `--inventory`; do not add the addresses here.
