# A Rustible workspace, generated by `rustible init`. Playbooks go in
# `playbooks/`, shared code in `src/lib.rs`. This manifest is yours to edit:
# add collections with `cargo add`.
[package]
name = "{{name}}"
version = "0.1.0"
edition = "2024"
publish = false
autobins = false

[[bin]]
name = "{{name}}"
path = "src/main.rs"

[lib]
path = "src/lib.rs"

# Enabled only by `rustible playbook run` together with RUSTIBLE_PLAYBOOK, so
# a selected build gets its own build-script output directory and never
# clobbers the editor's registry. Nothing may depend on it. (vision doc 9)
[features]
selected = []

[dependencies]
{{dependencies}}

[build-dependencies]
{{build_dependencies}}

# A Rustible workspace stands alone, even inside another Cargo workspace.
[workspace]

# Profile for binaries shipped to targets: small over fast-to-build. The
# rustible CLI builds with `--profile dist`.
[profile.dist]
inherits = "release"
strip = true
lto = "fat"
codegen-units = 1
opt-level = "z"
# The runtime turns a playbook panic into a reported failure with `catch_unwind`;
# `abort` would kill the remote binary with no report.
panic = "unwind"
